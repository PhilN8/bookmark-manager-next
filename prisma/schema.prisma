// Bookmark Manager Schema
// Supports both SQLite (dev) and PostgreSQL (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// BETTER-AUTH MODELS
// ============================================

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  passwordHash   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  workspaces     Workspace[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  providerType      String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpires DateTime?
  refreshTokenExpires DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerType, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, value])
}

// ============================================
// USER & WORKSPACE (MVP - Single User)
// ============================================

// Note: Original User model replaced with BetterAuth model above

model Workspace {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks  Bookmark[]
  folders    Folder[]
  tags       Tag[]

  @@index([userId])
}

// ============================================
// FOLDERS (Hierarchical)
// ============================================

model Folder {
  id          String    @id @default(cuid())
  name        String
  workspaceId String
  parentId    String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    Folder[]   @relation("FolderHierarchy")
  bookmarks   Bookmark[]

  @@index([workspaceId])
  @@index([workspaceId, parentId])
}

// ============================================
// TAGS
// ============================================

model Tag {
  id          String   @id @default(cuid())
  name        String
  workspaceId String
  createdAt   DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookmarkTags BookmarkTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ============================================
// BOOKMARKS (Core Entity)
// ============================================

model Bookmark {
  id          String    @id @default(cuid())
  title       String
  description String?
  folderId    String?
  workspaceId String
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  folder     Folder?       @relation(fields: [folderId], references: [id])
  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  urls       BookmarkUrl[]
  tags       BookmarkTag[]

  @@index([workspaceId, folderId])
  @@index([workspaceId, archived])
  // GIN index for full-text search will be created via migration
}

// ============================================
// BOOKMARK URLs (Multiple URLs per Bookmark)
// ============================================

model BookmarkUrl {
  id         String   @id @default(cuid())
  bookmarkId String
  url        String
  isPrimary  Boolean  @default(false)
  label      String?
  addedAt    DateTime @default(now())

  bookmark   Bookmark   @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  snapshots  Snapshot[]

  // Note: "only one primary per bookmark" is enforced in application logic.
  // A @@unique([bookmarkId, isPrimary]) constraint would incorrectly also allow
  // only one non-primary URL per bookmark (breaks at 3+ URLs).
  @@index([bookmarkId])
}

// ============================================
// BOOKMARK TAGS (Many-to-Many)
// ============================================

model BookmarkTag {
  bookmarkId String
  tagId      String

  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, tagId])
  @@index([tagId])
}

// ============================================
// SNAPSHOTS (Post-MVP - OUT OF SCOPE)
// ============================================

model Snapshot {
  id            String   @id @default(cuid())
  bookmarkUrlId String
  capturedAt    DateTime @default(now())
  storageUrl    String
  contentSize   Int?
  createdAt     DateTime @default(now())

  bookmarkUrl BookmarkUrl @relation(fields: [bookmarkUrlId], references: [id], onDelete: Cascade)

  @@index([bookmarkUrlId])
  @@index([capturedAt])
}
